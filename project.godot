[layer_names]

2d_physics/layer_1="Terreno"
2d_physics/layer_2="Vehiculo"
2d_physics/layer_3="Coleccionables"
2d_physics/layer_4="Sensores"

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.52, 0.78, 0.95, 1)
